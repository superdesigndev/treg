# Archive object storage. Supply credentials privately; never commit populated values.
TREG_ARCHIVE_OBJECT_STORE_ENDPOINT=
TREG_ARCHIVE_OBJECT_STORE_BUCKET=
TREG_ARCHIVE_OBJECT_STORE_ACCESS_KEY_ID=
TREG_ARCHIVE_OBJECT_STORE_SECRET_ACCESS_KEY=

# Omit these switches to retain the default db behavior. Uncomment with a valid value.
# Write accepts db / both / r2; reads accept db / r2-first.
# TREG_ARCHIVE_BODY_WRITE=
# TREG_ARCHIVE_BODY_READ_LOOKUP=
# TREG_ARCHIVE_BODY_READ_RESULT=
# TREG_ARCHIVE_BODY_READ_TERMINAL=

# Read timeout defaults to 2 seconds; upload keeps its separate timeout.
# TREG_ARCHIVE_R2_READ_TIMEOUT_S=

# Optional changed-path reporting (shares archive concurrency and lookup read mode).
TREG_ARCHIVE_CHANGE_OBSERVATION_ENABLED=true
