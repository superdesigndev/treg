 {
  "name": "doppler",
  "kind": "generated",
  "base_url": "https://api.doppler.com/v3",
  "secrets": [
   {
    "source": "env",
    "env": "DOPPLER_TOKEN",
    "name": "doppler-token",
    "kind": "env"
   }
  ],
  "bindings": [],
  "gaps": [
   "needs credential DOPPLER_TOKEN (not found in your environment)"
  ],
  "note": "catalog CLI skill",
  "cli": {
   "bin": "doppler",
   "install": "brew install dopplerhq/cli/doppler",
   "auth_mechanism": "env",
   "beta": true,
   "deny": [
    "(^|\\s)run(\\s|$)",
    "(^|\\s)secrets\\s+download(\\s|$)"
   ],
   "inject": [
    {
     "via": "env",
     "name": "DOPPLER_TOKEN",
     "secret": "doppler-token"
    }
   ],
   "errors": [
    {
     "pattern": "(?i)\\b401\\b|unauthorized|invalid.{0,10}(api.)?key|authentication",
     "verdict": "credential_invalid",
     "message": "the org's credential is invalid or expired"
    }
   ],
   "enabled": true
  }
 },
